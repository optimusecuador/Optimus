<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView Principal (Oculto por defecto hasta que se verifique la conexión) -->
    <WebView
        android:id="@+id/miWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pantalla de Instalación de Netbird (Oculta por defecto) -->
    <LinearLayout
        android:id="@+id/layoutErrorNetbird"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:background="#FFFFFF">

        <!-- Imagen personalizada (Asegúrate de agregar una imagen llamada "netbird_logo" en res/drawable) -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instalar Netbird"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se pudo conectar al servidor principal. Por favor, instala y activa Netbird con las siguientes credenciales:"
            android:textAlignment="center"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario: optimusecuador416@gmail.com\nContraseña: Optimus2023"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnRedLocal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Continuar con Red Local"
            android:textSize="16sp"/>
    </LinearLayout>
</FrameLayout>