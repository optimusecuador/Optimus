            <?php 
					// SACAR INFORMACION DE OLT
					// SELECCIONO OLT
					$sqlolno = "SELECT * from `nodo`";
					$resultolno = mysqli_query($con, $sqlolno);
					while($crowolno = mysqli_fetch_assoc($resultolno))
					{
					$nodoconeccion=$crowolno['codigo'];
					
					$sqlolt = "SELECT * from `olt_conexion` WHERE `nodo` LIKE '$nodoconeccion'";
					$resultolt = mysqli_query($con, $sqlolt);
					while($crowolt = mysqli_fetch_assoc($resultolt))
					{
					$host_olt=$crowolt['ip'];
					$u_olt=$crowolt['usuario'];
					$p_olt=$crowolt['contrasena'];
					}				
					// Establecer conexión SSH con olt
					$connection = ssh2_connect($host_olt, $port);
					if (!$connection) 
					{
					die("No se pudo establecer la conexión SSH.");
					}
					// Ejecutar un comando remoto recuperacion informacion olt
					$connection = ssh2_connect($host_olt, $port);
					if (!ssh2_auth_password($connection, $u_olt, $p_olt)) {
							die("La autenticación SSH falló.");
					}else
					{
					$command = 'enable'."\n".'config'."\n".'scroll 512'."\n".'display sysuptime'."\n";
					$stream = ssh2_exec($connection, $command);
					stream_set_blocking($stream, true);
					$output = stream_get_contents($stream);
					//$output;
					$separador = "time";
					$separada = explode($separador, $output);
					$separador = "second";
					$separadat = explode($separador, $separada[2]);
					}
					$connection = ssh2_connect($host_olt, $port);
					if (!ssh2_auth_password($connection, $u_olt, $p_olt)) {
							die("La autenticación SSH falló.");
					}else
					{
					$command = 'enable'."\n".'config'."\n".'scroll 512'."\n".'display cpu 0/1'."\n";
					$stream = ssh2_exec($connection, $command);
					stream_set_blocking($stream, true);
					$output = stream_get_contents($stream);
					//$output;
					$separador = "occupancy";
					$separadapor = explode($separador, $output);
					$separador = "%";
					$separadatpor = explode($separador, $separadapor[2]);
					//ssh2_disconnect($connection);
					$tarjetauno = $separadatpor[0]." %";
					
					}
					$connection = ssh2_connect($host_olt, $port);	
				
					if (!ssh2_auth_password($connection, $u_olt, $p_olt)) {
							die("La autenticación SSH falló.");
					}else
					{
					$command = 'enable'."\n".'config'."\n".'scroll 512'."\n".'display cpu 0/2'."\n";
					$stream = ssh2_exec($connection, $command);
					stream_set_blocking($stream, true);
					$output = stream_get_contents($stream);
					$separador = "occupancy";
					$separadapordos = explode($separador, $output);
					$separador = "%";
					$separadatpordos = explode($separador, $separadapordos[2]);
					$tarjetados = $separadatpordos[0]." %";
					}
					
					
					////////////pendiente de sacar informacion	
					$connection = ssh2_connect($host_olt, $port);
					if (!ssh2_auth_password($connection, $u_olt, $p_olt)) {
							die("La autenticación SSH falló.");
					}else
					{
					$command = 'enable'."\n".'config'."\n".'scroll 512'."\n".'interface gpon 0/1'."\n".'display ont port state 0 0 eth-port all'."\n";
					$stream = ssh2_exec($connection, $command);
					stream_set_blocking($stream, true);
					$output = stream_get_contents($stream);
					//$separador = "occupancy";
					//$separadapordos = explode($separador, $output);
					//$separador = "%";
					//$separadatpordos = explode($separador, $separadapordos[2]);
					//$tarjetados = $separadatpordos[0]." %";
					}	
